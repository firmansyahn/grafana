// host_metrics
//
// Collect host-level (node) metrics via the embedded node_exporter
// (prometheus.exporter.unix) and remote-write them to a Prometheus-compatible
// backend (e.g. Mimir) under a single tenant. Because each instance reads its
// own node's /proc, /sys and root filesystem via host mounts and scrapes only
// the local exporter, it is inherently node-local and is meant to run as a
// DaemonSet, or as a single Docker/Podman container on a plain container host.
//
// This is deliberately single-tenant and node-scoped: clustering is disabled
// so scrapes are NOT distributed across peers (that would scatter the series
// and break the instance=node mapping). For per-tenant workload metrics use
// the k8s_metrics module instead.
//
// Features:
//   - Self-contained per-node collector (host root/proc/sys via mounts).
//   - Stamps instance and node labels from the local node name.
//   - Stamps region / zone / cluster_name external labels.
//   - Embedded remote_write so the tenant (X-Scope-OrgID) is set per instance.
//   - Skips Docker, Podman and containerd per-container mounts, so container
//     churn does not churn node_filesystem_* series.
//
// Requirements:
//   - Host /, /proc and /sys mounted read-only into the collector at
//     /host/root, /host/proc and /host/sys respectively. The root mount needs
//     mountPropagation: HostToContainer (rslave under Docker/Podman) so the
//     host's /run tmpfs is visible underneath it — the diskstats collector
//     reads udev data from there.
//   - Kubernetes: K8S_NODE_NAME exposed to the collector (the Grafana Alloy
//     Helm chart injects this automatically from spec.nodeName); or pass
//     node_name.
//   - Docker/Podman: run with --pid=host and --network=host. /host/proc/net
//     resolves to the network namespace of the reading process, so without
//     host networking node_network_* reports the container's own interfaces
//     rather than the host's. The node name falls back to the container's
//     hostname, which under --network=host is the host's on both Docker and
//     Podman (verified); pass node_name if you cannot use host networking.
//     See the containers declare below for a full run command.
//
// Usage:
//   host_metrics.unix "node" {
//       tenant_id                    = "my-tenant"
//       endpoint_url                 = sys.env("MIMIR_ENDPOINT_URL")
//       endpoint_basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       endpoint_basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//       region                       = sys.env("REGION")
//       zone                         = sys.env("ZONE")
//       cluster_name                 = sys.env("CLUSTER_NAME")
//   }
declare "unix" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) to write node metrics to"
	}

	argument "endpoint_url" {
		comment = "Prometheus-compatible remote_write URL (e.g. Mimir)"
	}

	argument "endpoint_basic_auth_username" {
		comment = "Basic-auth username for the remote_write endpoint"
	}

	argument "endpoint_basic_auth_password" {
		comment = "Basic-auth password for the remote_write endpoint"
	}

	// -- Optional -----------------------------------------------------------
	argument "node_name" {
		comment  = "Node name for the instance/node labels (default: sys.env(\"K8S_NODE_NAME\"), injected by the Alloy Helm chart; outside Kubernetes, the hostname)"
		optional = true
	}

	argument "region" {
		comment  = "Value for the region external label (default: \"\", unset)"
		optional = true
	}

	argument "zone" {
		comment  = "Value for the zone external label (default: \"\", unset)"
		optional = true
	}

	argument "cluster_name" {
		comment  = "Value for the cluster_name external label (default: \"\", unset)"
		optional = true
	}

	argument "job_name" {
		comment  = "Value for the job label (default: \"integrations/unix\", the exporter's own). Set it to keep an existing job label when migrating a hand-written config onto this module, so dashboards and alerts selecting on it keep matching."
		optional = true
	}
	// Alloy has no map-merge function, so this REPLACES the default external
	// label set rather than adding to it: a caller that passes it and still
	// wants region/zone/cluster_name has to include them here. Region etc.
	// stay as named arguments because they are the common case.
	argument "external_labels" {
		comment  = "Complete external_labels map for the embedded remote_write, REPLACING the region/zone/cluster_name defaults (default: unset, which keeps them). Use it to carry site-specific labels such as environment or role."
		optional = true
	}
	// Alloy cannot pass relabel rule{} blocks as a value, so custom relabeling is
	// injected by receiver: point this at your own prometheus.relabel, which then
	// forwards back to this module's exported .receiver (the embedded remote_write).
	// An explicit [] coalesces to the default -- pass a real receiver, or omit.
	argument "extra_relabel_to" {
		comment  = "Optional list(MetricsReceiver) to forward node metrics to INSTEAD of the embedded remote_write -- typically your own prometheus.relabel for site-specific rules, which forwards back to this module's exported .receiver (default: the embedded remote_write)."
		optional = true
	}

	prometheus.exporter.unix "node" {
		rootfs_path = "/host/root"
		procfs_path = "/host/proc"
		sysfs_path  = "/host/sys"

		// Relative to rootfs_path, NOT an independent mount: the host's /run is
		// a tmpfs reached through the / mount at /host/root, so this must be
		// /host/root/run/... — matching upstream prometheus-node-exporter's
		// --path.udev.data. Pointing it at /host/run/... makes diskstats log
		// "Failed to open directory, disabling udev device properties" on every
		// scrape and drops node_disk_info's model/serial/revision labels.
		// Requires mountPropagation: HostToContainer on the root mount, or the
		// tmpfs is not visible underneath it.
		udev_data_path = "/host/root/run/udev/data"

		// The xfs collector fails to parse /proc/fs/xfs/stat on some kernels
		// ("xpc" line is not a uint), erroring on every scrape. It yields no
		// useful series here, so disable it.
		disable_collectors = ["infiniband", "tapestats", "xfs"]

		filesystem {
			// Podman's per-container /dev/shm is a tmpfs, so fs_types_exclude
			// does not catch it: it lives under graphroot overlay-containers/
			// <id>/userdata/shm -- /var/lib/containers/storage rootful,
			// ~/.local/share/containers/storage rootless (/var/home on
			// Fedora CoreOS-style hosts) -- next to runroot state under
			// /run/containers/storage or /run/user/<uid>/containers. Docker's
			// equivalent sits under /var/lib/docker/containers/<id>/mounts/shm.
			// On the Podman hosts checked this drops one tmpfs mount per
			// container -- 11 of them, churning on every restart -- plus
			// Podman's bind of graphroot/overlay onto itself, which reports
			// the same device as /var and would double-count its capacity.
			// On ostree hosts (Fedora CoreOS, RHCOS) the root partition is mounted
			// four times -- /sysroot, /var, /etc and /sysroot/ostree/deploy/<os>/var
			// -- so a single filesystem emits four identical node_filesystem_*
			// series and every filesystem alert fires four times per node. Checked
			// on a Fedora CoreOS 44 node: /dev/sda4 reports at all four, each with
			// the same 106769133568 size, and there is no "/" mountpoint at all.
			// Keep /var, which is what dashboards and alerts reference, and drop
			// the other three; root capacity stays visible through /var. /boot is a
			// separate partition (/dev/sda3) and is untouched. Non-ostree hosts have
			// no /sysroot, and their /etc is part of / rather than its own mount, so
			// this changes nothing for them.
			mount_points_exclude = "^/(dev|proc|sys|sysroot|etc|var/lib/docker/.+|var/lib/containers/storage/.+|var/lib/kubelet/.+|run/containerd/.+|run/containers/storage/.+|run/credentials/.+|run/user/[0-9]+/containers/.+|.+/\\.local/share/containers/storage/.+)($|/)"
			// mount_points_exclude = "^/(dev|proc|sys|var/lib/docker/.+|var/lib/kubelet/.+|run/containerd/io\.containerd\.grpc\.v1\.cri/sandboxes/[a-f0-9]{64}/shm)($|/)"
			fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
		}

		netclass {
			ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
		}
	}

	discovery.relabel "node" {
		targets = prometheus.exporter.unix.node.targets

		// Label every node series with the node it came from. The hostname
		// fallback only applies outside Kubernetes, where K8S_NODE_NAME is
		// unset; without it instance would be empty and Prometheus would
		// replace it with the exporter's internal address.
		rule {
			target_label = "instance"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"), constants.hostname)
		}

		rule {
			target_label = "node"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"), constants.hostname)
		}

		// Set job explicitly rather than relying on prometheus.scrape's
		// job_name: exporter targets already carry job="integrations/unix",
		// and a target's own job label wins over the scrape's default, so
		// job_name alone would be ignored.
		rule {
			target_label = "job"
			replacement  = coalesce(argument.job_name.value, "integrations/unix")
		}
	}

	prometheus.scrape "node" {
		targets    = discovery.relabel.node.output
		forward_to = [prometheus.relabel.node.receiver]

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		// Local exporter only — do not distribute across the cluster.
		clustering {
			enabled = false
		}
	}

	// node_uname_info carries a nodename label from uname(2): the OS hostname of
	// wherever the exporter runs. On a DaemonSet that is the Alloy POD name (e.g.
	// alloy-5fwxp), so every pod reschedule mints a fresh nodename and therefore a
	// brand-new node_uname_info series. That churn inflates the tenant's active
	// series and, once it sits at max_global_series_per_user, the new series is
	// rejected outright (per_user_series_limit) and the node silently loses
	// node_uname_info. Rewrite nodename to the same stable node identity already
	// stamped on instance and node above.
	//
	// Scoped with source_labels so it only rewrites series that ALREADY carry a
	// nodename (node_uname_info); a bare target_label would stamp nodename onto
	// every node_* series. Outside Kubernetes K8S_NODE_NAME is unset and this
	// resolves to constants.hostname -- the same value uname already reports -- so
	// it is a no-op on standalone VMs and Docker/Podman hosts.
	prometheus.relabel "node" {
		// Caller's chain if extra_relabel_to is set, else straight to remote_write.
		// The nodename rule below always runs first, so custom rules see the
		// normalized value.
		forward_to = coalesce(argument.extra_relabel_to.value, [prometheus.remote_write.default.receiver])

		rule {
			source_labels = ["nodename"]
			regex         = ".+"
			target_label  = "nodename"
			replacement   = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"), constants.hostname)
		}
	}

	// Exposed so a caller passing extra_relabel_to can forward its own
	// prometheus.relabel back into this module's tenant-configured remote_write.
	export "receiver" {
		value = prometheus.remote_write.default.receiver
	}

	prometheus.remote_write "default" {
		endpoint {
			url = argument.endpoint_url.value

			basic_auth {
				username = argument.endpoint_basic_auth_username.value
				password = argument.endpoint_basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = coalesce(argument.external_labels.value, {
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
			cluster_name = coalesce(argument.cluster_name.value, ""),
		})
	}
}

// kubelet
//
// Scrape the LOCAL node's kubelet directly (:10250) for its four metric
// endpoints — /metrics, /metrics/cadvisor, /metrics/probes and
// /metrics/resource — and remote-write them under a single tenant.
//
// Why not a ServiceMonitor: prometheus.operator.servicemonitors rejects
// kube-prometheus-stack's kubelet ServiceMonitor, which hardcodes
// bearerTokenFile and tlsConfig.caFile, because allow_arbitrary_file_access
// defaults to false. That guard exists so a ServiceMonitor author cannot make
// the collector read its own service account token and post it to a target
// they control. It does not apply to a hand-written scrape config like this
// one, so scraping natively fixes kubelet without weakening the guard for
// ServiceMonitors that genuinely come from CRDs.
//
// Node-scoped and single-tenant, like unix above: each DaemonSet pod keeps
// only its own node's target and clustering is disabled, so kubelet series are
// not scattered across peers and instance=node stays one-to-one.
//
// Label shape deliberately matches what prometheus-operator produced, so
// existing dashboards and alerts keep working: job="kubelet" on all four
// endpoints, distinguished by an explicit metrics_path label.
//
// Requirements:
//   - RBAC: get/list/watch on nodes and nodes/metrics. The Alloy Helm chart
//     grants both by default via rbac.clusterRules.
//   - K8S_NODE_NAME exposed to the collector (the Grafana Alloy Helm chart
//     injects this automatically from spec.nodeName); or pass node_name.
//
// Usage:
//   host_metrics.kubelet "kubelet" {
//       tenant_id                    = "my-tenant"
//       endpoint_url                 = sys.env("MIMIR_ENDPOINT_URL")
//       endpoint_basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       endpoint_basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//       region                       = sys.env("REGION")
//       zone                         = sys.env("ZONE")
//       cluster_name                 = sys.env("CLUSTER_NAME")
//   }
declare "kubelet" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) to write kubelet metrics to"
	}

	argument "endpoint_url" {
		comment = "Prometheus-compatible remote_write URL (e.g. Mimir)"
	}

	argument "endpoint_basic_auth_username" {
		comment = "Basic-auth username for the remote_write endpoint"
	}

	argument "endpoint_basic_auth_password" {
		comment = "Basic-auth password for the remote_write endpoint"
	}

	// -- Optional -----------------------------------------------------------
	argument "node_name" {
		comment  = "Node name for the instance/node labels and the local-node filter (default: sys.env(\"K8S_NODE_NAME\"), injected by the Alloy Helm chart)"
		optional = true
	}
	// Uses default rather than coalesce() at the use site: false is a zero
	// value to coalesce, so coalesce(argument..., true) would silently ignore
	// an explicit false and always skip verification.
	argument "insecure_skip_verify" {
		comment  = "Skip verification of the kubelet serving certificate (default: true). The kubelet self-signs unless the cluster runs with serverTLSBootstrap, so the service account CA does not validate it — this is why kube-prometheus-stack also defaults to true. Set false only where kubelet certs are signed by the cluster CA."
		optional = true
		default  = true
	}

	argument "region" {
		comment  = "Value for the region external label (default: \"\", unset)"
		optional = true
	}

	argument "zone" {
		comment  = "Value for the zone external label (default: \"\", unset)"
		optional = true
	}

	argument "cluster_name" {
		comment  = "Value for the cluster_name external label (default: \"\", unset)"
		optional = true
	}

	// role = "node" sets __address__ to the node's address on the kubelet port
	// (10250), which is exactly what we want to scrape.
	discovery.kubernetes "nodes" {
		role = "node"
	}

	discovery.relabel "node" {
		targets = discovery.kubernetes.nodes.targets

		// Every DaemonSet pod discovers every node, so drop all but our own.
		// Without this, each node's kubelet would be scraped once per node in
		// the cluster.
		rule {
			source_labels = ["__meta_kubernetes_node_name"]
			regex         = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"))
			action        = "keep"
		}

		rule {
			target_label = "instance"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"))
		}

		rule {
			target_label = "node"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"))
		}
	}

	// One relabel per endpoint, solely to materialise the metrics_path label.
	// Prometheus discards __metrics_path__ (double-underscore labels never
	// survive relabeling), so the dashboards' metrics_path selector needs it
	// set as a real label here.
	discovery.relabel "kubelet" {
		targets = discovery.relabel.node.output

		rule {
			target_label = "metrics_path"
			replacement  = "/metrics"
		}
	}

	discovery.relabel "cadvisor" {
		targets = discovery.relabel.node.output

		rule {
			target_label = "metrics_path"
			replacement  = "/metrics/cadvisor"
		}
	}

	discovery.relabel "probes" {
		targets = discovery.relabel.node.output

		rule {
			target_label = "metrics_path"
			replacement  = "/metrics/probes"
		}
	}

	discovery.relabel "resource" {
		targets = discovery.relabel.node.output

		rule {
			target_label = "metrics_path"
			replacement  = "/metrics/resource"
		}
	}

	prometheus.scrape "kubelet" {
		targets    = discovery.relabel.kubelet.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name     = "kubelet"
		metrics_path = "/metrics"
		scheme       = "https"

		// honor_labels so cAdvisor's own namespace/pod/container labels win
		// over anything the target carries, matching prometheus-operator.
		honor_labels = true

		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = argument.insecure_skip_verify.value
		}

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		// Local node only — do not distribute across the cluster.
		clustering {
			enabled = false
		}
	}

	prometheus.scrape "cadvisor" {
		targets    = discovery.relabel.cadvisor.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name     = "kubelet"
		metrics_path = "/metrics/cadvisor"
		scheme       = "https"
		honor_labels = true

		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = argument.insecure_skip_verify.value
		}

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		clustering {
			enabled = false
		}
	}

	prometheus.scrape "probes" {
		targets    = discovery.relabel.probes.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name     = "kubelet"
		metrics_path = "/metrics/probes"
		scheme       = "https"
		honor_labels = true

		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = argument.insecure_skip_verify.value
		}

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		clustering {
			enabled = false
		}
	}

	prometheus.scrape "resource" {
		targets    = discovery.relabel.resource.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name     = "kubelet"
		metrics_path = "/metrics/resource"
		scheme       = "https"
		honor_labels = true

		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = argument.insecure_skip_verify.value
		}

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		clustering {
			enabled = false
		}
	}

	prometheus.remote_write "default" {
		endpoint {
			url = argument.endpoint_url.value

			basic_auth {
				username = argument.endpoint_basic_auth_username.value
				password = argument.endpoint_basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = {
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
			cluster_name = coalesce(argument.cluster_name.value, ""),
		}
	}
}

// control_plane
//
// Scrape the LOCAL node's kube-controller-manager (:10257), kube-scheduler
// (:10259) and etcd (:2381), and remote-write them under a single tenant.
// Yields no targets on nodes that are not control-plane nodes, so it is safe
// to instantiate once across a DaemonSet covering the whole cluster.
//
// ON A WORKER NODE this declare does nothing at all. Every DaemonSet pod
// discovers every node, so local_control_plane below applies two keep rules in
// sequence: keep the pod's OWN node, then keep only nodes carrying
// node-role.kubernetes.io/control-plane. A worker passes the first and fails
// the second, so the target list comes out EMPTY. A prometheus.scrape with an
// empty targets list issues no requests, emits no `up` series and logs
// nothing — the components stay healthy with zero targets. There is no need
// to gate instantiation by node role; that is the whole point of the pattern.
//
// Why not ServiceMonitors: kube-prometheus-stack's kubeControllerManager and
// kubeScheduler ServiceMonitors hardcode bearerTokenFile and tlsConfig.caFile.
// Unlike coreDns/kubeProxy/kubeEtcd, whose bearer token is value-controlled,
// there is no way to switch them off, and prometheus.operator.servicemonitors
// rejects both outright now that allow_arbitrary_file_access defaults to
// false. Same reasoning and same fix as the kubelet declare above.
//
// kubeEtcd is here for the same practical reason even though its token IS
// value-controlled: KPS ships that ServiceMonitor with bearerTokenFile set, so
// out of the box prometheus.operator.servicemonitors refuses it with
// "uses bearerTokenFile, which is disallowed because allow_arbitrary_file_access
// is false" and etcd is silently never scraped — discovered, no targets, no
// error. Scraping it directly here sidesteps the CRD conversion entirely.
// (The restriction applies to ServiceMonitor conversion, not to a
// prometheus.scrape written in config — which is why controller_manager and
// scheduler may still use bearer_token_file below.)
//
// IMPORTANT — bind address:
//   kubeadm defaults controller-manager and scheduler to
//   --bind-address=127.0.0.1, and etcd to --listen-metrics-urls=
//   http://127.0.0.1:2381, which makes their metrics reachable only from the
//   host's own loopback. Alloy runs in the pod network namespace, so under
//   those defaults this module discovers the targets and every scrape fails
//   with connection refused. The KPS ServiceMonitors could not reach them
//   either, so this is not a regression introduced here. To collect these
//   metrics set --bind-address=0.0.0.0 in
//   /etc/kubernetes/manifests/kube-{controller-manager,scheduler}.yaml and
//   --listen-metrics-urls=http://0.0.0.0:2381 in
//   /etc/kubernetes/manifests/etcd.yaml on each control-plane node, one node
//   at a time (each edit restarts that static pod; do the raft leader last).
//   The controller-manager and scheduler ports stay protected by their own
//   authn/authz webhooks. etcd's :2381 is UNAUTHENTICATED by design and
//   carries no key material — only counters and histograms — which is why the
//   scrape below sends no credentials. It is a separate listener from the
//   client (:2379) and peer (:2380) ports, both of which remain mTLS-only.
//
//   A cluster with external or managed etcd, or one that leaves :2381 on
//   loopback, will show up{job="kube-etcd"} == 0 rather than nothing at all.
//   Alert on etcd_server_has_leader rather than on target count, and see the
//   note on `count()` under Requirements below.
//
// WHY THIS MODULE NEEDS THE 0.0.0.0 BIND WHEN OTHER SCRAPERS DO NOT:
//   "etcd is on 127.0.0.1:2381" does not mean etcd is unscrapable. Two other
//   routes exist, and most working etcd monitoring uses the first:
//
//   1. The CLIENT port also serves /metrics. --listen-client-urls already
//      includes the node IP (https://<node-ip>:2379) and etcd serves the very
//      same /metrics there over mTLS — verified on this cluster: 621 etcd_*
//      series, etcd_server_has_leader and the fsync histogram included. That
//      is the classic kube-prometheus-stack setup (kubeEtcd.serviceMonitor
//      scheme=https plus caFile/certFile/keyFile from a Secret built out of
//      /etc/kubernetes/pki/etcd/). It works from anywhere on the network no
//      matter what --listen-metrics-urls is bound to.
//
//      We deliberately do NOT do this. Those are etcd CLIENT credentials —
//      full read/write access to every Secret in the cluster. Mounting them
//      into a metrics collector to read counters is a bad trade, and it is
//      exactly why etcd grew a separate unauthenticated metrics listener.
//
//   2. Anything in the HOST network namespace reaches 127.0.0.1:2381 on its
//      own node, because the etcd static pod is hostNetwork: true — that
//      loopback is the node's, not a pod sandbox's. A hostNetwork DaemonSet,
//      or a Prometheus running on the master itself, needs no bind change at
//      all. Alloy here runs on the CNI pod network with its own loopback, so
//      it cannot. Switching the whole DaemonSet to hostNetwork for one scrape
//      would drag the OTLP receiver onto host ports and change the collector's
//      identity everywhere else; not worth it.
//
//   So 2381 is preferred over 2379 because it needs no credentials — not
//   because it is the only way in.
//
// BEFORE YOU BIND 2381 OUTWARD, CHECK WHO CAN REACH IT:
//   The listener has no authentication of any kind. On a node with a single
//   NIC the bind choice is BINARY — loopback, or the node IP. There is no
//   third address: a Calico direct-routing (non-overlay) node holds no
//   tunnel/VXLAN address and no address inside the pod CIDR, so there is
//   nothing to bind that pods can reach but the rest of the network cannot.
//   "Bind to the node IP instead of 0.0.0.0" is NOT a hardening step; the node
//   IP is exactly what an off-cluster client connects to.
//
//   Measured 2026-09-20: with 2381 on 0.0.0.0, a workstation on the
//   VPN overlay read all three members' /metrics unauthenticated —
//   cluster version, member IDs, leader, raft term, DB size, key count,
//   request rates and fsync latency. No secrets and no write path, but full
//   topology and health, plus an unauthenticated CPU sink on a control-plane
//   node. That cluster reverted to 127.0.0.1 and left etcd unscraped rather
//   than keep it open.
//
//   Exposing 2381 is right when the node network is genuinely private —
//   which is the assumption kube-prometheus-stack is built on, and the one
//   worth actually testing rather than inheriting. Where it is not private
//   and a host firewall is unwanted, the alternative is to scrape from inside
//   the host network namespace (a hostNetwork collector reaching
//   127.0.0.1:2381), which needs no bind change at all — at the cost of
//   granting that collector hostNetwork.
//
// Label shape matches what prometheus-operator produced —
// job="kube-controller-manager", job="kube-scheduler" and job="kube-etcd" —
// so existing dashboards and alerts keep working.
//
// Requirements:
//   - RBAC: get/list/watch on nodes, plus get on the /metrics nonResourceURL.
//     The Alloy Helm chart grants both by default via rbac.clusterRules.
//   - K8S_NODE_NAME exposed to the collector (the Grafana Alloy Helm chart
//     injects this automatically from spec.nodeName); or pass node_name.
//   - Control-plane nodes labelled node-role.kubernetes.io/control-plane.
//
// Alerting note — do not count targets:
//   Each control-plane pod scrapes only its own node, so a member that stops
//   reporting simply stops producing series. Series go stale after ~5 minutes,
//   so an expression like count(etcd_server_has_leader) < 3 decays 3 -> 2 -> 1
//   -> 0 and reads exactly like a member loss even when the cause is that a
//   collector restarted. Alert on what a member reports about ITSELF
//   (etcd_server_has_leader == 0, fsync and commit latency, leader changes),
//   and catch a missing node with kube_node_status_condition from
//   kube-state-metrics, which runs elsewhere and still reports on a node that
//   can no longer ship anything of its own.
//
// Usage:
//   host_metrics.control_plane "control_plane" {
//       tenant_id                    = "my-tenant"
//       endpoint_url                 = sys.env("MIMIR_ENDPOINT_URL")
//       endpoint_basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       endpoint_basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//       region                       = sys.env("REGION")
//       zone                         = sys.env("ZONE")
//       cluster_name                 = sys.env("CLUSTER_NAME")
//   }
declare "control_plane" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) to write control-plane metrics to"
	}

	argument "endpoint_url" {
		comment = "Prometheus-compatible remote_write URL (e.g. Mimir)"
	}

	argument "endpoint_basic_auth_username" {
		comment = "Basic-auth username for the remote_write endpoint"
	}

	argument "endpoint_basic_auth_password" {
		comment = "Basic-auth password for the remote_write endpoint"
	}

	// -- Optional -----------------------------------------------------------
	argument "node_name" {
		comment  = "Node name for the instance/node labels and the local-node filter (default: sys.env(\"K8S_NODE_NAME\"), injected by the Alloy Helm chart)"
		optional = true
	}
	// Ports are strings so they can be concatenated straight into the
	// __address__ replacement below without a formatting function.
	argument "controller_manager_port" {
		comment  = "kube-controller-manager secure port (default: \"10257\")"
		optional = true
		default  = "10257"
	}

	argument "scheduler_port" {
		comment  = "kube-scheduler secure port (default: \"10259\")"
		optional = true
		default  = "10259"
	}

	argument "etcd_port" {
		comment  = "etcd metrics port (default: \"2381\"). Plain HTTP and unauthenticated by design; separate from the client (2379) and peer (2380) mTLS listeners."
		optional = true
		default  = "2381"
	}

	argument "insecure_skip_verify" {
		comment  = "Skip verification of the components' serving certificates (default: true). kubeadm gives both self-signed certs that the cluster CA does not validate, which is why kube-prometheus-stack also defaults to true."
		optional = true
		default  = true
	}

	argument "region" {
		comment  = "Value for the region external label (default: \"\", unset)"
		optional = true
	}

	argument "zone" {
		comment  = "Value for the zone external label (default: \"\", unset)"
		optional = true
	}

	argument "cluster_name" {
		comment  = "Value for the cluster_name external label (default: \"\", unset)"
		optional = true
	}

	discovery.kubernetes "nodes" {
		role = "node"
	}

	discovery.relabel "local_control_plane" {
		targets = discovery.kubernetes.nodes.targets

		// Every DaemonSet pod discovers every node, so drop all but our own.
		rule {
			source_labels = ["__meta_kubernetes_node_name"]
			regex         = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"))
			action        = "keep"
		}

		// Control-plane nodes only. labelpresent_ is used rather than the
		// label itself because node-role.kubernetes.io/control-plane carries
		// an empty value, which a regex on the value cannot match reliably.
		// On a worker this leaves zero targets and the scrapes below no-op.
		rule {
			source_labels = ["__meta_kubernetes_node_labelpresent_node_role_kubernetes_io_control_plane"]
			regex         = "true"
			action        = "keep"
		}

		rule {
			target_label = "instance"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"))
		}

		rule {
			target_label = "node"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"))
		}
	}

	// role = "node" addresses the kubelet port, so rewrite __address__ to the
	// node's InternalIP on each component's own secure port.
	discovery.relabel "controller_manager" {
		targets = discovery.relabel.local_control_plane.output

		rule {
			source_labels = ["__meta_kubernetes_node_address_InternalIP"]
			regex         = "(.+)"
			replacement   = "$1:" + argument.controller_manager_port.value
			target_label  = "__address__"
			action        = "replace"
		}
	}

	discovery.relabel "scheduler" {
		targets = discovery.relabel.local_control_plane.output

		rule {
			source_labels = ["__meta_kubernetes_node_address_InternalIP"]
			regex         = "(.+)"
			replacement   = "$1:" + argument.scheduler_port.value
			target_label  = "__address__"
			action        = "replace"
		}
	}

	discovery.relabel "etcd" {
		targets = discovery.relabel.local_control_plane.output

		rule {
			source_labels = ["__meta_kubernetes_node_address_InternalIP"]
			regex         = "(.+)"
			replacement   = "$1:" + argument.etcd_port.value
			target_label  = "__address__"
			action        = "replace"
		}
	}

	prometheus.scrape "controller_manager" {
		targets    = discovery.relabel.controller_manager.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name = "kube-controller-manager"
		scheme   = "https"

		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = argument.insecure_skip_verify.value
		}

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		// Local node only — do not distribute across the cluster.
		clustering {
			enabled = false
		}
	}

	prometheus.scrape "scheduler" {
		targets    = discovery.relabel.scheduler.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name = "kube-scheduler"
		scheme   = "https"

		bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

		tls_config {
			ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
			insecure_skip_verify = argument.insecure_skip_verify.value
		}

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		clustering {
			enabled = false
		}
	}

	// etcd's metrics listener is plain HTTP with no authn: no scheme = "https",
	// no bearer_token_file, no tls_config. A token here would be inert, and it
	// is exactly the bearerTokenFile on the KPS kubeEtcd ServiceMonitor that
	// gets that CRD rejected by prometheus.operator.servicemonitors — see the
	// header.
	prometheus.scrape "etcd" {
		targets    = discovery.relabel.etcd.output
		forward_to = [prometheus.remote_write.default.receiver]

		job_name = "kube-etcd"
		scheme   = "http"

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		// Local node only. Leaving clustering on would hash the etcd targets
		// across every Alloy pod in the DaemonSet, which both breaks the
		// node-local guarantee this declare is built on and makes a target's
		// owner move on every rollout.
		clustering {
			enabled = false
		}
	}

	prometheus.remote_write "default" {
		endpoint {
			url = argument.endpoint_url.value

			basic_auth {
				username = argument.endpoint_basic_auth_username.value
				password = argument.endpoint_basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = {
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
			cluster_name = coalesce(argument.cluster_name.value, ""),
		}
	}
}

// containers
//
// Per-container CPU, memory, block I/O and pids metrics on hosts that run
// containers directly under Docker and/or Podman, where there is no kubelet
// to scrape cAdvisor from. Runs the embedded cAdvisor
// (prometheus.exporter.cadvisor) and remote-writes under a single tenant.
// Node-scoped and single-tenant like unix: clustering is disabled and
// instance=node.
//
// One declare for both runtimes rather than one each: cAdvisor keeps
// process-global state, so Alloy supports a single prometheus.exporter.cadvisor
// per process. Instantiate this once per Alloy; a host running both Docker and
// Podman is covered by that one instance.
//
// How each runtime is seen:
//   - Docker: through cAdvisor's Docker handler over docker_host, with name,
//     image and the allowlisted container labels, plus per-container network.
//     Per-container filesystem USAGE (container_fs_usage_bytes and friends for
//     a container id) is missing when Docker uses the containerd image store,
//     the default for fresh installs since Docker 29: cAdvisor takes the
//     container's rootfs path from containerd and cannot map it to a device.
//     container_fs_* is then only reported for the host root cgroup. Verified
//     on Docker 29.4 with driver-type io.containerd.snapshotter.v1.
//   - Podman: cAdvisor has a Podman handler but Alloy does not compile it in,
//     so Podman containers fall through to the generic cgroup (raw) handler.
//     That handler knows only the cgroup path: CPU, memory, block I/O and
//     pids are complete, but there is no name, image or labels, and no
//     per-container network or filesystem metrics. container_id is recovered
//     from the cgroup path so series stay identifiable, and containers run as
//     systemd units via Quadlet also get name=<unit> from it -- which in
//     practice covers a Quadlet-managed host entirely, since every unit lands
//     in /system.slice/<unit>.service/libpod-payload-<id>. Only ad-hoc
//     `podman run` containers, which sit in /machine.slice, stay unnamed.
//
// Do NOT point docker_host at Podman's Docker-compatible socket to get names.
// The Docker handler accepts the container, then looks for Docker's on-disk
// layer database to locate its root filesystem, does not find it, and fails
// to create the handler -- the container is dropped outright rather than
// falling back to the raw handler.
//
// Labels added to container series:
//   runtime       "docker" or "podman".
//   container_id  12-character short ID, as `docker ps` / `podman ps` print it.
//   name          Docker: the container name. Podman: the Quadlet unit name
//                 when run as one, otherwise unset.
//
// Cardinality: cAdvisor runs with docker_only = false, so it tracks every
// cgroup on the host -- each systemd service, user session and scope -- not
// just containers. docker_only = true would suppress those, but it also
// disables the raw handler Podman depends on, and its prefix allowlist cannot
// express rootless or Quadlet cgroup paths, which embed a uid or unit name.
// So collection stays broad and prometheus.relabel keeps only machine-level
// series, the root cgroup (id="/"), and Docker/Podman container cgroups.
// Podman's conmon scopes and nested cgroups inside a container are dropped so
// container sums are not double-counted.
//
// The machine_* series (machine_cpu_cores, machine_memory_bytes, ...) are kept
// by those rules but land unreliably, which is cAdvisor's doing, not theirs:
// it stamps them with the moment it read the machine info and never advances
// that timestamp, so only the first write after a restart is accepted and
// every later copy is a duplicate sample. Do not build on them -- the unix
// declare reports the same capacity as node_cpu_seconds_total and
// node_memory_MemTotal_bytes, with timestamps that move.
//
// Requirements (Alloy in a container; natively on the host none of the mounts
// or flags apply):
//   - Root, --privileged, --pid=host and --cgroupns=host, so cgroup and
//     /proc paths resolve to the host's.
//   - Host / mounted read-only at /rootfs, in addition to unix's /host/root.
//     cAdvisor hardcodes this path: when /rootfs/proc exists it reads host
//     files through /rootfs, including Docker's layer database under
//     /var/lib/docker. Without it every Docker container fails to register.
//   - /sys at /sys and /dev/disk at /dev/disk, read-only.
//   - Docker only: the Docker socket at docker_host, the containerd socket at
//     /run/containerd/containerd.sock, and /var/lib/docker read-only at the
//     SAME path. Docker Engine 29+ fresh installs use the containerd image
//     store, where cAdvisor resolves each container's root filesystem through
//     containerd and then stats the absolute path containerd reports
//     (/var/lib/docker/rootfs/overlayfs/<id>) WITHOUT the /rootfs prefix it
//     applies elsewhere. Unmounted, that stat fails and every container logs
//     "failed to collect filesystem stats" on each housekeeping pass.
//
// Run (rootful Docker; for Podman use `podman run` with the same flags and
// drop the two socket mounts on a Podman-only host):
//   docker run -d --name alloy --user 0 --privileged \
//     --pid=host --network=host --cgroupns=host \
//     -v /:/host/root:ro,rslave -v /proc:/host/proc:ro -v /sys:/host/sys:ro \
//     -v /:/rootfs:ro -v /sys:/sys:ro -v /dev/disk:/dev/disk:ro \
//     -v /var/run/docker.sock:/var/run/docker.sock:ro \
//     -v /run/containerd/containerd.sock:/run/containerd/containerd.sock:ro \
//     -v /var/lib/docker:/var/lib/docker:ro \
//     -v ./config.alloy:/etc/alloy/config.alloy:ro \
//     grafana/alloy:v1.19.2 run /etc/alloy/config.alloy
//
// Verified end to end on Ubuntu 24.04 + Docker 29.4 (containerd image store,
// 12 Compose containers) and Fedora CoreOS + Podman 5.7.1 (11 Quadlet units),
// with this command: both declares healthy, no errors, every container
// reported and named, and no cgroup other than containers and the host root.
//
// Usage:
//   host_metrics.containers "containers" {
//       tenant_id                    = "my-tenant"
//       endpoint_url                 = sys.env("MIMIR_ENDPOINT_URL")
//       endpoint_basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       endpoint_basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//       node_name                    = sys.env("NODE_NAME")
//       region                       = sys.env("REGION")
//       zone                         = sys.env("ZONE")
//       cluster_name                 = sys.env("CLUSTER_NAME")
//   }
declare "containers" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) to write container metrics to"
	}

	argument "endpoint_url" {
		comment = "Prometheus-compatible remote_write URL (e.g. Mimir)"
	}

	argument "endpoint_basic_auth_username" {
		comment = "Basic-auth username for the remote_write endpoint"
	}

	argument "endpoint_basic_auth_password" {
		comment = "Basic-auth password for the remote_write endpoint"
	}

	// -- Optional -----------------------------------------------------------
	argument "node_name" {
		comment  = "Node name for the instance/node labels (default: sys.env(\"K8S_NODE_NAME\"), else the hostname)"
		optional = true
	}

	argument "docker_host" {
		comment  = "Docker Engine endpoint (default: \"unix:///var/run/docker.sock\"). On a Podman-only host leave it: cAdvisor logs that the Docker factory failed to register and carries on. Never Podman's socket -- see the header."
		optional = true
		default  = "unix:///var/run/docker.sock"
	}
	// default rather than coalesce() at the use site: an explicit [] is a
	// zero value to coalesce and would silently bring the defaults back.
	argument "allowlisted_container_labels" {
		comment  = "Docker container labels to keep as container_label_<name> (default: the Compose project and service). Every other label is dropped: images commonly carry a dozen OCI annotations that would otherwise land on every series. Docker only; Podman containers have no labels here."
		optional = true
		default  = ["com.docker.compose.project", "com.docker.compose.service"]
	}

	argument "region" {
		comment  = "Value for the region external label (default: \"\", unset)"
		optional = true
	}

	argument "zone" {
		comment  = "Value for the zone external label (default: \"\", unset)"
		optional = true
	}

	argument "cluster_name" {
		comment  = "Value for the cluster_name external label (default: \"\", unset)"
		optional = true
	}

	argument "job_name" {
		comment  = "Value for the job label (default: \"integrations/cadvisor\", the exporter's own). Set it to match an existing convention so dashboards and alerts selecting on job keep matching."
		optional = true
	}
	// Replaces rather than extends the default set -- see the note on the
	// same argument in unix above.
	argument "external_labels" {
		comment  = "Complete external_labels map for the embedded remote_write, REPLACING the region/zone/cluster_name defaults (default: unset, which keeps them). Use it to carry site-specific labels such as environment or role."
		optional = true
	}
	// Alloy cannot pass relabel rule{} blocks as a value, so custom relabeling is
	// injected by receiver: point this at your own prometheus.relabel, which then
	// forwards back to this module's exported .receiver (the embedded remote_write).
	// An explicit [] coalesces to the default -- pass a real receiver, or omit.
	argument "extra_relabel_to" {
		comment  = "Optional list(MetricsReceiver) to forward container metrics to INSTEAD of the embedded remote_write -- typically your own prometheus.relabel for site-specific rules, which forwards back to this module's exported .receiver (default: the embedded remote_write)."
		optional = true
	}

	prometheus.exporter.cadvisor "containers" {
		docker_host = argument.docker_host.value

		// false is load-bearing for Podman -- see the header.
		docker_only = false

		store_container_labels       = false
		allowlisted_container_labels = argument.allowlisted_container_labels.value
	}

	discovery.relabel "containers" {
		targets = prometheus.exporter.cadvisor.containers.targets

		rule {
			target_label = "instance"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"), constants.hostname)
		}

		rule {
			target_label = "node"
			replacement  = coalesce(argument.node_name.value, sys.env("K8S_NODE_NAME"), constants.hostname)
		}

		// Explicit for the same reason as in unix: the exporter's target
		// already carries job="integrations/cadvisor".
		rule {
			target_label = "job"
			replacement  = coalesce(argument.job_name.value, "integrations/cadvisor")
		}
	}

	prometheus.scrape "containers" {
		targets    = discovery.relabel.containers.output
		forward_to = [prometheus.relabel.containers.receiver]

		scrape_interval = "30s"
		scrape_timeout  = "10s"

		// Local exporter only — do not distribute across the cluster.
		clustering {
			enabled = false
		}
	}

	// Exposed so a caller passing extra_relabel_to can forward its own
	// prometheus.relabel back into this module's tenant-configured remote_write.
	export "receiver" {
		value = prometheus.remote_write.default.receiver
	}

	prometheus.relabel "containers" {
		// Caller's chain if extra_relabel_to is set, else straight to remote_write.
		// The runtime/container_id/name rules below always run first, so custom
		// rules see the normalized labels.
		forward_to = coalesce(argument.extra_relabel_to.value, [prometheus.remote_write.default.receiver])

		// Docker first, and before any rule below writes name: only the
		// Docker handler names containers, so a name at this point means a
		// Docker container regardless of its cgroup layout (systemd or
		// cgroupfs driver, rootless, custom --cgroup-parent).
		rule {
			source_labels = ["name"]
			regex         = ".+"
			target_label  = "runtime"
			replacement   = "docker"
		}

		// Podman container cgroups, matched on the leaf so every layout is
		// covered: /machine.slice/libpod-<id>.scope (rootful, systemd),
		// /libpod_parent/libpod-<id> (cgroupfs), .../user.slice/libpod-<id>.scope
		// (rootless) and .../<unit>.service/libpod-payload-<id> (Quadlet's
		// --cgroups=split). Anchored at the end, so libpod-conmon-<id>.scope
		// (the conmon monitor process, not the container) and cgroups nested
		// inside a container are left unmatched and dropped below.
		rule {
			source_labels = ["id"]
			regex         = ".*/libpod-(payload-)?[0-9a-f]{64}(\\.scope)?"
			target_label  = "runtime"
			replacement   = "podman"
		}

		// Keep containers, machine-level series (no id: machine_*, and the
		// exporter's own) and the root cgroup; drop every other cgroup.
		rule {
			source_labels = ["runtime", "id"]
			separator     = ";"
			regex         = "(docker|podman);.*|;/?"
			action        = "keep"
		}

		rule {
			source_labels = ["runtime", "id"]
			separator     = ";"
			regex         = "(docker|podman);.*[/-]([0-9a-f]{12})[0-9a-f]{52}(\\.scope)?"
			target_label  = "container_id"
			replacement   = "$2"
		}

		// Quadlet containers carry their unit in the cgroup path, the one
		// name the raw handler can offer.
		rule {
			source_labels = ["runtime", "id"]
			separator     = ";"
			regex         = "podman;.*/([^/]+)\\.service/libpod-payload-[0-9a-f]{64}"
			target_label  = "name"
			replacement   = "$1"
		}
	}

	prometheus.remote_write "default" {
		endpoint {
			url = argument.endpoint_url.value

			basic_auth {
				username = argument.endpoint_basic_auth_username.value
				password = argument.endpoint_basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = coalesce(argument.external_labels.value, {
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
			cluster_name = coalesce(argument.cluster_name.value, ""),
		})
	}
}
