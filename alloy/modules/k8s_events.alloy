// k8s_events
//
// Kubernetes events as log lines. loki.source.kubernetes_events watches the
// API server for events and ships each one as a line, in JSON (the default)
// or logfmt. The pipeline parses either format, turns the event's type,
// reason, object kind, reporting component and node into labels, adds a
// level label, keeps the object's name as structured metadata, and drops
// Normal events except the reasons in keep_normal_reasons.
//
// Tenancy: namespaces limits the watch to the namespaces listed, so one
// instance per tenant sends each tenant only its own namespaces' events, the
// way k8s_pod_logs_file does for pod logs. An instance without namespaces
// watches every namespace. Instances whose namespaces overlap each ship the
// overlapping events. Events about cluster-scoped objects, such as nodes, are
// recorded in the "default" namespace, so only an instance that watches
// "default" (or every namespace) sees them.
//
// Safe on every pod of a clustered DaemonSet: each watched namespace is one
// clustering key (all namespaces is a single key), so exactly one peer
// watches it and each event is shipped once. Without clustering, every Alloy
// that runs this ships every event.
//
// Normal events are mostly routine (Scheduled, Pulled, Created, Started) and
// are dropped by default. Node condition changes are Normal too, though: the
// node controller and the kubelet report NodeNotReady and NodeHasDiskPressure
// as Normal, not Warning. keep_normal_reasons keeps those by default. Pass []
// to drop every Normal event, or drop_normal_events = false to keep them all.
//
// Labels:
//   job           integrations/kubernetes/eventhandler, or job_label
//   namespace     the namespace of the object the event is about (none for
//                 cluster-scoped objects such as nodes)
//   type          Normal or Warning
//   level         info (Normal) or warn (Warning), for Grafana's log level
//                 colouring and filter, as k8s_pod_logs_file sets for pod logs
//   reason        e.g. BackOff, FailedScheduling, NodeNotReady
//   kind          the object's kind, e.g. Pod, Node
//   source        the component that reported it, e.g. kubelet, default-scheduler
//   node          the node it was reported from, when there is one
//   cluster_name  when cluster_name is set
// Structured metadata:
//   name          the object's name; one per pod, so not a label. Query it
//                 with `| name="..."`.
// The line keeps the whole event: name, message (msg), count and the rest.
//
// Requirements:
//   - RBAC: get/list/watch on events.
//   - Loki with allow_structured_metadata: true (tsdb + schema v13) for the
//     name structured metadata.
//
// Usage:
//   k8s_events.kubernetes "my_tenant" {
//       namespaces   = ["my-namespace"]
//       tenant_id    = "my-tenant"
//       cluster_name = "my-cluster"
//       forward_to   = [loki.write.default.receiver]
//   }
declare "kubernetes" {
	// -- Required -----------------------------------------------------------
	argument "forward_to" {
		comment = "Must be a list(LogsReceiver) where collected logs should be forwarded to"
	}

	// -- Optional -----------------------------------------------------------
	argument "tenant_id" {
		comment  = "The Loki tenant (X-Scope-OrgID) to stamp on collected events (default: unset, so the tenant_id of the loki.write they reach applies)"
		optional = true
	}

	argument "namespaces" {
		comment  = "The namespaces to watch for events (default: [] is all namespaces)"
		optional = true
	}

	argument "cluster_name" {
		comment  = "Value for the static cluster_name label (default: \"\", unset)"
		optional = true
	}

	argument "job_label" {
		comment  = "The job label of the event streams (default: integrations/kubernetes/eventhandler)"
		optional = true
	}

	argument "log_format" {
		comment  = "Line format of each event, \"json\" or \"logfmt\" (default: \"json\")"
		optional = true
	}

	argument "drop_normal_events" {
		comment  = "Drop events of type Normal, except the reasons in keep_normal_reasons (default: true)"
		default  = true
		optional = true
	}

	argument "keep_normal_reasons" {
		comment = "Reasons of Normal events to keep while drop_normal_events is true; [] keeps none (default: the node condition changes, NodeNotReady, NodeHasDiskPressure and the like)"
		default = [
			"NodeReady",
			"NodeNotReady",
			"NodeSchedulable",
			"NodeNotSchedulable",
			"NodeHasDiskPressure",
			"NodeHasNoDiskPressure",
			"NodeHasInsufficientMemory",
			"NodeHasSufficientMemory",
			"NodeHasInsufficientPID",
			"NodeHasSufficientPID",
		]
		optional = true
	}

	loki.source.kubernetes_events "cluster_events" {
		job_name   = coalesce(argument.job_label.value, "integrations/kubernetes/eventhandler")
		namespaces = coalesce(argument.namespaces.value, [])
		log_format = coalesce(argument.log_format.value, "json")
		forward_to = [
			loki.process.cluster_events.receiver,
		]

		// Each watched namespace is one clustering key, and watching all
		// namespaces is a single key, so exactly one peer owns each.
		clustering {
			enabled = true
		}
	}

	loki.process "cluster_events" {
		forward_to = argument.forward_to.value

		// Parse by the line's own format, since log_format can pick either.
		// The field names are the ones loki.source.kubernetes_events writes,
		// the same in both formats.
		stage.match {
			selector      = `{job=~".+"} |~ "^[{]"`
			pipeline_name = "json"

			stage.json {
				expressions = {
					type   = "type",
					reason = "reason",
					kind   = "kind",
					source = "sourcecomponent",
					node   = "sourcehost",
					name   = "name",
				}
			}
		}

		stage.match {
			selector      = `{job=~".+"} !~ "^[{]"`
			pipeline_name = "logfmt"

			stage.logfmt {
				mapping = {
					type   = "",
					reason = "",
					kind   = "",
					source = "sourcecomponent",
					node   = "sourcehost",
					name   = "",
				}
			}
		}

		stage.labels {
			values = {
				type   = "", // Normal or Warning
				reason = "", // e.g. BackOff, Pulled, Scheduled
				kind   = "", // e.g. Pod, Deployment
				source = "", // e.g. kubelet, default-scheduler
				node   = "",
			}
		}

		// After stage.labels: a selector matches labels, not extracted fields.
		// The "false" branch selects a label no entry carries, a valid selector
		// that matches nothing, since Alloy has no conditional blocks. An empty
		// keep_normal_reasons would join to "", a regex that keeps any event
		// with no reason, so it falls back to a reason no event has.
		stage.match {
			selector = {
				"true"  = `{type="Normal", reason!~"` + coalesce(string.join(argument.keep_normal_reasons.value, "|"), "k8s_events_keep_none") + `"}`,
				"false" = `{k8s_events_never_matches="1"}`,
			}[string.format("%t", argument.drop_normal_events.value)]

			action              = "drop"
			drop_counter_reason = "normal_events"
		}

		// Kubernetes allows only these two types.
		stage.template {
			source   = "level"
			template = `{{ if eq .type "Warning" }}warn{{ else if eq .type "Normal" }}info{{ end }}`
		}

		stage.labels {
			values = {
				level = "",
			}
		}

		// A name per object would mean a stream per object as a label.
		stage.structured_metadata {
			values = {
				name = "",
			}
		}

		// instance is the source component's ID, the same on every line.
		stage.label_drop {
			values = ["instance"]
		}

		stage.static_labels {
			values = {
				cluster_name = argument.cluster_name.value,
			}
		}

		// stage.tenant rejects an empty value, so without tenant_id the stage is
		// skipped by the same never-matching selector as the drop above, and the
		// entries reach loki.write with no tenant of their own.
		stage.match {
			selector = {
				"true"  = `{job=~".+"}`,
				"false" = `{k8s_events_never_matches="1"}`,
			}[string.format("%t", coalesce(argument.tenant_id.value, "") != "")]

			stage.tenant {
				value = coalesce(argument.tenant_id.value, "unset")
			}
		}
	}
}
