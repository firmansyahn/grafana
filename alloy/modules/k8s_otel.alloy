// k8s_otel
//
// An OpenTelemetry enrichment gateway: accepts OTLP over gRPC (4317) and HTTP
// (4318), enriches every signal with Kubernetes and static attributes,
// batches, and forwards each signal to caller-provided consumers:
//   - logs    -> logs_forward_to
//   - traces  -> traces_forward_to
//   - metrics -> metrics_forward_to
//
// This gateway has NO embedded sinks: the caller must fan every signal out,
// typically to the per-tenant tenant_route sieves declared below (a filter ->
// exporter branch per tenant, keyed on the k8s.namespace.name that
// k8sattributes stamps here).
//
// Because k8sattributes resolves the sending pod by source IP against the API
// server, the k8s.namespace.name it stamps cannot be spoofed by the client --
// it is not read from the OTLP payload. All three signals pass through it, so
// each carries a trustworthy namespace for downstream per-tenant routing.
//
// A servicegraph connector derives request metrics from spans. It runs inside
// each tenant_route (not the gateway), fed by that tenant's already-filtered
// traces, so service graphs are per-tenant and cover all of a tenant's
// namespaces. Its edge metrics ship under that tenant's X-Scope-OrgID.
//
// Pipeline (gateway):
//   receiver -> memory_limiter -> k8sattributes -> attributes -> batch -> *_forward_to
//     logs    -> logs_forward_to
//     traces  -> traces_forward_to
//     metrics -> metrics_forward_to
//
// Pipeline (per tenant_route):
//   logs    : filter -> otlphttp
//   traces  : filter -> [otlphttp, servicegraph, spanmetrics]
//   metrics : filter ----\
//   servicegraph --------- transform (promote k8s resource attrs to
//   spanmetrics ---------/  datapoint labels) -> exporter.prometheus -> remote_write
//
// Requirements:
//   - RBAC: get/list/watch on pods (for k8sattributes).
//   - Ports 4317/4318 reachable (expose them via the Alloy Helm chart).
//
// Usage:
//   k8s_otel.default "otlp" {
//       logs_forward_to    = [k8s_otel.tenant_route.acme.logs_input]
//       traces_forward_to  = [k8s_otel.tenant_route.acme.traces_input]
//       metrics_forward_to = [k8s_otel.tenant_route.acme.metrics_input]
//       cluster_name       = sys.env("CLUSTER_NAME")
//   }
declare "default" {
	// -- Required -----------------------------------------------------------
	// The caller must fan out every signal to its own consumers (typically the
	// per-tenant tenant_route sieves). This gateway has no embedded default
	// sinks -- it only receives, enriches and batches.
	argument "logs_forward_to" {
		comment = "list(otelcol.Consumer) the enriched, batched logs signal is forwarded to"
	}
	argument "traces_forward_to" {
		comment = "list(otelcol.Consumer) the enriched, batched traces signal is forwarded to"
	}
	argument "metrics_forward_to" {
		comment = "list(otelcol.Consumer) the enriched, batched raw OTLP metrics are forwarded to (typically per-tenant routes)"
	}

	// -- Optional -----------------------------------------------------------
	argument "cluster_name" {
		comment  = "Value for the static cluster_name attribute inserted on every signal (default: \"\", unset)"
		optional = true
	}
	argument "project_label_key" {
		comment  = "Pod label key to promote to the project.name resource attribute, e.g. \"app.kubernetes.io/part-of\". Empty disables it (default: \"\")"
		optional = true
	}
	argument "node_name" {
		comment  = "Node whose pods k8sattributes watches/caches. Leave empty for a Deployment gateway (must watch all nodes, since senders are cluster-wide). Under a DaemonSet, pass sys.env(\"K8S_NODE_NAME\") so each pod caches only its own node -- otherwise every pod caches the WHOLE cluster's pod metadata and OOMs at scale (default: \"\", watch all)"
		optional = true
	}
	argument "memory_limit_percentage" {
		comment  = "Hard memory limit for the OTLP receiver, as a percentage of the pod's memory limit; over the soft limit (hard - spike) the receiver drops data and pushes back (default: 80)"
		optional = true
	}
	argument "memory_spike_limit_percentage" {
		comment  = "Spike allowance as a percentage of the pod's memory limit; the soft limit is (memory_limit_percentage - this). Recommended ~20-25% of the hard limit (default: 25)"
		optional = true
	}

	otelcol.receiver.otlp "default" {
		grpc {
			endpoint = "0.0.0.0:4317"
		}
		http {
			endpoint         = "0.0.0.0:4318"
			logs_url_path    = "/v1/logs"
			metrics_url_path = "/v1/metrics"
			traces_url_path  = "/v1/traces"
		}

		// First stop is memory_limiter, so a receive spike or a stalled backend
		// applies backpressure (drops + errors to the client) instead of OOM-
		// killing the pod. It is the DaemonSet's guardrail: an OOM here would
		// also take down this node's log/metric collection.
		output {
			logs    = [otelcol.processor.memory_limiter.default.input]
			metrics = [otelcol.processor.memory_limiter.default.input]
			traces  = [otelcol.processor.memory_limiter.default.input]
		}
	}

	// Guardrail before any enrichment: bound memory use of the OTLP receiver.
	// Percentage-based so it tracks the pod's memory limit rather than a fixed
	// byte value. The soft limit is (memory_limit_percentage -
	// memory_spike_limit_percentage); above it, data is dropped and the client
	// is told to back off; above the hard limit a GC is forced.
	otelcol.processor.memory_limiter "default" {
		check_interval          = "1s"
		limit_percentage        = coalesce(argument.memory_limit_percentage.value, 80)
		spike_limit_percentage  = coalesce(argument.memory_spike_limit_percentage.value, 25)

		// All three signals route through k8sattributes so each carries a
		// server-derived k8s.namespace.name for downstream per-tenant routing.
		// servicegraph is NOT run here: it lives inside each tenant_route,
		// deriving edge metrics from that tenant's already-filtered traces, so
		// service graphs are per-tenant and multi-namespace within a tenant.
		output {
			logs    = [otelcol.processor.k8sattributes.default.input]
			metrics = [otelcol.processor.k8sattributes.default.input]
			traces  = [otelcol.processor.k8sattributes.default.input]
		}
	}

	otelcol.processor.k8sattributes "default" {
		// Restrict the pod-metadata cache to a single node when node_name is set.
		// The default ("") watches all pods, which is REQUIRED for a Deployment
		// gateway: senders live cluster-wide, so scoping to the gateway's own node
		// would drop enrichment for every pod elsewhere. Under a DaemonSet the
		// caller MUST pass its node (K8S_NODE_NAME): senders are always node-local
		// so scoping is loss-free, and without it every pod caches the WHOLE
		// cluster's pods (this processor is the heaviest memory consumer here),
		// giving an (all pods x every node) footprint that OOMs at scale. Topology
		// is the caller's to declare -- the module stays neutral.
		filter {
			node = coalesce(argument.node_name.value, "")
		}

		extract {
			metadata = [
				"k8s.node.name",
				"k8s.namespace.name",
				"k8s.deployment.name",
				"k8s.pod.name",
				"k8s.pod.uid",
				"k8s.pod.start_time",
				"k8s.container.name",
				"container.id",
				"container.image.name",
				"container.image.tag",
			]

			// Promote a caller-chosen pod label to the project.name resource
			// attribute. When project_label_key is unset the key is "", which
			// matches no pod label, so no attribute is added.
			label {
				from     = "pod"
				key      = coalesce(argument.project_label_key.value, "")
				tag_name = "project.name"
			}
		}

		// Logs and metrics share one attributes processor (cluster_name);
		// traces get their own (k8s.cluster.name), since the cluster attribute
		// key differs by backend: Loki/Mimir use cluster_name, Tempo uses the
		// OTel-convention k8s.cluster.name.
		output {
			logs    = [otelcol.processor.attributes.default.input]
			metrics = [otelcol.processor.attributes.default.input]
			traces  = [otelcol.processor.attributes.traces.input]
		}
	}

	// Logs + metrics: stamp cluster_name, matching the external label the
	// metrics scrape paths use (host_metrics / k8s_metrics), so metrics
	// correlate across scrape and OTLP, and logs share the same key.
	otelcol.processor.attributes "default" {
		output {
			logs    = [otelcol.processor.batch.default.input]
			metrics = [otelcol.processor.batch.default.input]
		}

		action {
			key    = "cluster_name"
			value  = coalesce(argument.cluster_name.value, "")
			action = "insert"
		}

		action {
			key            = "http.response.status_code"
			converted_type = "int"
			action         = "convert"
		}
	}

	// Traces: stamp k8s.cluster.name (OTel semantic convention) for Tempo.
	otelcol.processor.attributes "traces" {
		output {
			traces = [otelcol.processor.batch.default.input]
		}

		action {
			key    = "k8s.cluster.name"
			value  = coalesce(argument.cluster_name.value, "")
			action = "insert"
		}

		action {
			key            = "http.response.status_code"
			converted_type = "int"
			action         = "convert"
		}
	}

	// Enriched, batched signals go to the caller-provided fan-out. This gateway
	// has no embedded sinks -- every signal is required to be forwarded on.
	otelcol.processor.batch "default" {
		output {
			logs    = argument.logs_forward_to.value
			metrics = argument.metrics_forward_to.value
			traces  = argument.traces_forward_to.value
		}
	}
}

// k8s_otel.tenant_route
//
// One tenant's enforced OTLP egress route, the per-tenant counterpart to the
// k8s_otel.default gateway above. The gateway enriches every signal with
// a server-derived k8s.namespace.name (un-spoofable) and forwards the stream
// to each tenant_route; each route keeps only its own namespaces and exports
// logs/traces stamped with a fixed X-Scope-OrgID.
//
// keep_condition is an OTTL boolean built by the caller (typically Helm, from
// the tenant's namespace list) that is TRUE for records to DROP -- i.e. it
// matches every namespace EXCEPT this tenant's, so only this tenant's records
// survive. A record whose namespace is in no tenant_route survives none and is
// dropped (strict enforcement). The enriched signals enter via the exported
// logs_input / traces_input consumers.
//
// Instantiate once per tenant and wire the gateway's logs_forward_to /
// traces_forward_to to the exports:
//
//   k8s_otel.tenant_route "acme" {
//       tenant_id           = "acme"
//       keep_condition      = "resource.attributes[\"k8s.namespace.name\"] != \"acme-ns\""
//       logs_endpoint       = sys.env("LOKI_OTLP_ENDPOINT_URL")
//       traces_endpoint     = sys.env("OTLPHTTP_CLIENT_ENDPOINT")
//       basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//   }
//   k8s_otel.default "otlp" {
//       logs_forward_to   = [k8s_otel.tenant_route.acme.logs_input]
//       traces_forward_to = [k8s_otel.tenant_route.acme.traces_input]
//       ...
//   }
declare "tenant_route" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) stamped on this route's exported logs and traces"
	}
	argument "keep_condition" {
		comment = "OTTL boolean, TRUE for records to drop; matches every namespace except this tenant's, so only this tenant's records survive"
	}
	argument "logs_endpoint" {
		comment = "OTLP-HTTP base endpoint for this tenant's logs (e.g. Loki's \"<addr>/otlp\")"
	}
	argument "traces_endpoint" {
		comment = "OTLP-HTTP base endpoint for this tenant's traces (e.g. Tempo)"
	}
	argument "metrics_endpoint" {
		comment = "Prometheus-compatible remote_write URL (e.g. Mimir) for this tenant's metrics"
	}
	argument "basic_auth_username" {
		comment = "Basic-auth username for the logs, traces and metrics endpoints"
	}
	argument "basic_auth_password" {
		comment = "Basic-auth password for the logs, traces and metrics endpoints"
	}

	// -- Optional -----------------------------------------------------------
	argument "region" {
		comment  = "Value for the region external label on this tenant's metrics (default: \"\", unset)"
		optional = true
	}
	argument "zone" {
		comment  = "Value for the zone external label on this tenant's metrics (default: \"\", unset)"
		optional = true
	}
	argument "cluster_name" {
		comment  = "Value for the cluster_name external label on this tenant's metrics (default: \"\", unset)"
		optional = true
	}
	argument "servicegraph_dimensions" {
		comment  = "Extra span dimensions this tenant's servicegraph connector promotes to labels, using newer OTel HTTP semconv (default: [\"http.request.method\", \"http.route\"])"
		optional = true
	}
	argument "spanmetrics_histogram_buckets" {
		comment  = "Explicit latency histogram bucket boundaries for this tenant's spanmetrics duration metric (default: [\"100ms\", \"250ms\", \"500ms\", \"1s\", \"2.5s\", \"5s\", \"10s\"])"
		optional = true
	}

	// Enriched logs/metrics/traces enter here; the gateway forwards to these.
	export "logs_input" {
		value = otelcol.processor.filter.logs.input
	}
	export "metrics_input" {
		value = otelcol.processor.filter.metrics.input
	}
	export "traces_input" {
		value = otelcol.processor.filter.traces.input
	}

	otelcol.auth.basic "default" {
		username = argument.basic_auth_username.value
		password = argument.basic_auth_password.value
	}

	otelcol.processor.filter "logs" {
		error_mode = "ignore"
		logs {
			log_record = [
				argument.keep_condition.value,
			]
		}
		output {
			logs = [otelcol.exporter.otlphttp.logs.input]
		}
	}

	otelcol.exporter.otlphttp "logs" {
		client {
			endpoint = argument.logs_endpoint.value
			auth     = otelcol.auth.basic.default.handler
			headers  = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}
	}

	// This tenant's traces fan out to three places: the OTLP trace exporter, a
	// per-tenant servicegraph (edge/topology metrics), and a per-tenant
	// spanmetrics (RED metrics). Because the filter already dropped every other
	// tenant's spans, both connectors derive metrics only from this tenant's
	// namespaces (all of them), and their metrics ship under this tenant_id.
	otelcol.processor.filter "traces" {
		error_mode = "ignore"
		traces {
			span = [
				argument.keep_condition.value,
			]
		}
		output {
			traces = [
				otelcol.exporter.otlphttp.traces.input,
				otelcol.connector.servicegraph.default.input,
				otelcol.connector.spanmetrics.default.input,
			]
		}
	}

	otelcol.connector.servicegraph "default" {
		dimensions = coalesce(argument.servicegraph_dimensions.value, ["http.request.method", "http.route"])
		output {
			metrics = [otelcol.processor.transform.promote.input]
		}
	}

	// RED metrics (calls_total + duration histogram) derived from this tenant's
	// spans. Built-in dimensions are service.name/span.name/span.kind/
	// status.code; the dimension blocks below add http.request.method,
	// http.route (templated path -- the per-endpoint latency key), and
	// http.response.status_code. These are the newer OTel HTTP semantic
	// conventions (http.request.method / http.response.status_code, not the
	// legacy http.method / http.status_code). (spanmetrics dimensions are
	// repeated blocks, not a list attribute, so they can't be driven by an
	// argument the way servicegraph_dimensions is.) Emits into the same
	// per-tenant prometheus exporter, so RED metrics ship under this tenant's
	// X-Scope-OrgID alongside the servicegraph edges.
	otelcol.connector.spanmetrics "default" {
		// Flush the accumulated metrics periodically so counters/histograms are
		// emitted on a fixed cadence rather than only when spans arrive.
		metrics_flush_interval = "15s"

		dimension {
			name = "http.request.method"
		}
		dimension {
			name = "http.route"
		}
		dimension {
			name = "http.response.status_code"
		}

		histogram {
			explicit {
				buckets = coalesce(argument.spanmetrics_histogram_buckets.value, ["100ms", "250ms", "500ms", "1s", "2.5s", "5s", "10s"])
			}
		}

		output {
			metrics = [otelcol.processor.transform.promote.input]
		}
	}

	otelcol.exporter.otlphttp "traces" {
		client {
			endpoint = argument.traces_endpoint.value
			auth     = otelcol.auth.basic.default.handler
			headers  = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}
	}

	// Raw OTLP metrics: keep only this tenant's namespaces (same keep_condition,
	// applied in the metric context), convert OTLP -> Prometheus, and
	// remote_write with this tenant's X-Scope-OrgID. Raw metrics carry
	// k8s.namespace.name (the gateway enriches them via k8sattributes). This
	// tenant's servicegraph metrics bypass this filter and feed
	// exporter.prometheus.metrics directly (they are already tenant-scoped by
	// the traces filter upstream).
	otelcol.processor.filter "metrics" {
		error_mode = "ignore"
		metrics {
			metric = [
				argument.keep_condition.value,
			]
		}
		output {
			metrics = [otelcol.processor.transform.promote.input]
		}
	}

	// Promote a bounded set of k8s enrichment attributes from OTLP *resource*
	// attributes onto each metric *datapoint*, so otelcol.exporter.prometheus
	// turns them into Prometheus labels. Without this the k8sattributes
	// enrichment is silently dropped at conversion: exporter.prometheus does NOT
	// convert resource attributes to labels by default
	// (resource_to_telemetry_conversion defaults to false), so raw OTLP metrics
	// would reach Mimir with no namespace/pod/deployment/project labels.
	//
	// The target attribute names are the BARE label names (namespace, pod,
	// deployment, project_name), deliberately matching the labels the scrape
	// path (k8s_metrics: relabel to namespace/pod/container/node/project_name)
	// emits -- so an OTLP-pushed series and a scraped series for the same
	// workload carry identical selectors and join/aggregate cleanly in Mimir.
	// The OTel-dotted source keys (k8s.namespace.name, ...) would otherwise
	// sanitize to k8s_namespace_name and NOT line up.
	//
	// We promote only these four (not the full k8sattributes list) on purpose:
	// k8s.pod.uid, k8s.pod.start_time, container.id, container.image.tag are
	// high-cardinality and would explode the Mimir series count as labels.
	// All three metric producers (raw OTLP, servicegraph, spanmetrics) route
	// through here, so every exported series carries the same k8s labels.
	otelcol.processor.transform "promote" {
		error_mode = "ignore"
		metric_statements {
			context = "datapoint"
			statements = [
				`set(attributes["namespace"], resource.attributes["k8s.namespace.name"])`,
				`set(attributes["deployment"], resource.attributes["k8s.deployment.name"])`,
				`set(attributes["pod"], resource.attributes["k8s.pod.name"])`,
				`set(attributes["project_name"], resource.attributes["project.name"])`,
			]
		}
		output {
			metrics = [otelcol.exporter.prometheus.metrics.input]
		}
	}

	otelcol.exporter.prometheus "metrics" {
		// target_info duplicates resource attributes into a separate series; the
		// labels we actually query by are promoted onto the datapoints above, so
		// target_info is redundant cardinality here.
		include_target_info = false
		forward_to          = [prometheus.remote_write.metrics.receiver]
	}

	prometheus.remote_write "metrics" {
		endpoint {
			url = argument.metrics_endpoint.value

			basic_auth {
				username = argument.basic_auth_username.value
				password = argument.basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = {
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
			cluster_name = coalesce(argument.cluster_name.value, ""),
		}
	}
}
