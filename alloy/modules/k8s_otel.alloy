// k8s_otel
//
// An OpenTelemetry collection gateway: accepts OTLP over gRPC (4317) and HTTP
// (4318), enriches every signal with Kubernetes and static attributes,
// batches, and routes the three signals. Each signal ships to an embedded,
// tenant-stamped default sink, or to a caller-provided override:
//   - logs    -> logs_forward_to    (default: embedded otlphttp -> logs_endpoint)
//   - traces  -> traces_forward_to  (default: embedded otlphttp -> traces_endpoint)
//   - metrics -> metrics_forward_to (default: embedded prometheus.remote_write)
//
// The defaults make the module self-contained and single-tenant: logs, traces
// and metrics are all stamped with one tenant_id. A caller that needs
// per-tenant routing overrides logs_forward_to / traces_forward_to with its
// own consumers (e.g. a filter -> exporter branch per tenant, keyed on the
// k8s.namespace.name that k8sattributes stamps here).
//
// Because k8sattributes resolves the sending pod by source IP against the API
// server, the k8s.namespace.name it stamps cannot be spoofed by the client --
// it is not read from the OTLP payload. Logs and traces pass through it, so
// both carry a trustworthy namespace for downstream routing. Metrics skip it
// (single-tenant, not namespace-routed).
//
// A servicegraph connector derives request metrics from spans and folds them
// back into the metrics stream.
//
// Pipeline:
//   logs    : receiver -> k8sattributes -> attributes -> batch -> logs_forward_to
//   traces  : receiver -> k8sattributes -> attributes -> batch -> traces_forward_to
//   metrics : receiver -> attributes -> batch -> exporter.prometheus -> metrics_forward_to
//             + servicegraph span metrics -> batch
//
// Requirements:
//   - RBAC: get/list/watch on pods (for k8sattributes).
//   - Ports 4317/4318 reachable (expose them via the Alloy Helm chart).
//   - The logs backend must accept OTLP ingestion. For Loki, enable
//     allow_structured_metadata and point logs_endpoint at "<addr>/otlp".
//
// Usage:
//   k8s_otel.default "otlp" {
//       tenant_id                    = sys.env("TENANT_ID")
//       metrics_endpoint         = sys.env("MIMIR_ENDPOINT_URL")
//       logs_endpoint                = sys.env("LOKI_OTLP_ENDPOINT_URL")
//       traces_endpoint              = sys.env("OTLPHTTP_CLIENT_ENDPOINT")
//       endpoint_basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       endpoint_basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//       region                       = sys.env("REGION")
//       zone                         = sys.env("ZONE")
//       cluster_name                 = sys.env("CLUSTER_NAME")
//   }
declare "default" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) stamped on the embedded default sinks"
	}
	argument "metrics_endpoint" {
		comment = "Prometheus-compatible remote_write URL (e.g. Mimir) for the default metrics sink"
	}
	argument "logs_endpoint" {
		comment = "OTLP-HTTP base endpoint for the default logs sink, e.g. Loki's \"<addr>/otlp\" (\"/v1/logs\" is appended)"
	}
	argument "traces_endpoint" {
		comment = "OTLP-HTTP base endpoint for the default traces sink (\"/v1/traces\" is appended)"
	}
	argument "endpoint_basic_auth_username" {
		comment = "Basic-auth username for the embedded default sinks"
	}
	argument "endpoint_basic_auth_password" {
		comment = "Basic-auth password for the embedded default sinks"
	}

	// -- Optional -----------------------------------------------------------
	argument "logs_forward_to" {
		comment  = "list(otelcol.Consumer) for logs (default: the module's own tenant-stamped otlphttp exporter)"
		optional = true
	}
	argument "traces_forward_to" {
		comment  = "list(otelcol.Consumer) for traces (default: the module's own tenant-stamped otlphttp exporter)"
		optional = true
	}
	argument "metrics_forward_to" {
		comment  = "list(MetricsReceiver) for metrics (default: the module's own tenant-stamped prometheus.remote_write)"
		optional = true
	}
	argument "region" {
		comment  = "Value for the region external label on metrics (default: \"\", unset)"
		optional = true
	}
	argument "zone" {
		comment  = "Value for the zone external label on metrics (default: \"\", unset)"
		optional = true
	}
	argument "cluster_name" {
		comment  = "Value for the static cluster_name attribute and metrics external label (default: \"\", unset)"
		optional = true
	}
	argument "servicegraph_dimensions" {
		comment  = "Extra span dimensions the servicegraph connector promotes to labels (default: [\"http.method\", \"http.target\"])"
		optional = true
	}

	otelcol.auth.basic "default" {
		username = argument.endpoint_basic_auth_username.value
		password = argument.endpoint_basic_auth_password.value
	}

	otelcol.receiver.otlp "default" {
		grpc {
			endpoint = "0.0.0.0:4317"
		}
		http {
			endpoint         = "0.0.0.0:4318"
			logs_url_path    = "/v1/logs"
			metrics_url_path = "/v1/metrics"
			traces_url_path  = "/v1/traces"
		}

		// Logs and traces route through k8sattributes so both carry a
		// server-derived k8s.namespace.name for downstream tenant routing.
		// Metrics skip it (single-tenant, not namespace-routed). servicegraph
		// derives span metrics in parallel.
		output {
			logs    = [otelcol.processor.k8sattributes.default.input]
			metrics = [otelcol.processor.attributes.default.input]
			traces  = [
				otelcol.connector.servicegraph.default.input,
				otelcol.processor.k8sattributes.default.input,
			]
		}
	}

	otelcol.connector.servicegraph "default" {
		dimensions = coalesce(argument.servicegraph_dimensions.value, ["http.method", "http.target"])
		output {
			metrics = [otelcol.processor.batch.default.input]
		}
	}

	otelcol.processor.k8sattributes "default" {
		extract {
			metadata = [
				"k8s.node.name",
				"k8s.namespace.name",
				"k8s.deployment.name",
				"k8s.pod.name",
				"k8s.pod.uid",
				"k8s.pod.start_time",
				"k8s.container.name",
				"container.id",
				"container.image.name",
				"container.image.tag",
			]
		}

		// Enriched logs and traces continue to attributes, then batch.
		output {
			logs   = [otelcol.processor.attributes.default.input]
			traces = [otelcol.processor.attributes.default.input]
		}
	}

	otelcol.processor.attributes "default" {
		output {
			logs    = [otelcol.processor.batch.default.input]
			metrics = [otelcol.processor.batch.default.input]
			traces  = [otelcol.processor.batch.default.input]
		}

		action {
			key    = "cluster_name"
			value  = coalesce(argument.cluster_name.value, "")
			action = "insert"
		}

		action {
			key            = "http.status_code"
			converted_type = "int"
			action         = "convert"
		}
	}

	// Each signal goes to its caller-provided override, or falls back to the
	// module's own embedded, tenant-stamped default sink.
	otelcol.processor.batch "default" {
		output {
			logs    = coalesce(argument.logs_forward_to.value, [otelcol.exporter.otlphttp.logs.input])
			metrics = [otelcol.exporter.prometheus.default.input]
			traces  = coalesce(argument.traces_forward_to.value, [otelcol.exporter.otlphttp.traces.input])
		}
	}

	// Default logs sink: OTLP-native to Loki's /otlp endpoint (the exporter
	// appends /v1/logs), preserving full OTLP semantics instead of the
	// constrained Prometheus-style label translation otelcol.exporter.loki
	// applies. Loki must have allow_structured_metadata enabled to accept it.
	otelcol.exporter.otlphttp "logs" {
		client {
			endpoint = argument.logs_endpoint.value
			auth     = otelcol.auth.basic.default.handler
			headers  = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}
	}

	// Default traces sink: OTLP-native to the trace backend (e.g. Tempo).
	otelcol.exporter.otlphttp "traces" {
		client {
			endpoint = argument.traces_endpoint.value
			auth     = otelcol.auth.basic.default.handler
			headers  = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}
	}

	otelcol.exporter.prometheus "default" {
		forward_to = coalesce(argument.metrics_forward_to.value, [prometheus.remote_write.default.receiver])
	}

	prometheus.remote_write "default" {
		endpoint {
			url = argument.metrics_endpoint.value

			basic_auth {
				username = argument.endpoint_basic_auth_username.value
				password = argument.endpoint_basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = {
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
			cluster_name = coalesce(argument.cluster_name.value, ""),
		}
	}
}

// k8s_otel.tenant_route
//
// One tenant's enforced OTLP egress route, the per-tenant counterpart to the
// k8s_otel.default gateway above. The gateway enriches every signal with
// a server-derived k8s.namespace.name (un-spoofable) and forwards the stream
// to each tenant_route; each route keeps only its own namespaces and exports
// logs/traces stamped with a fixed X-Scope-OrgID.
//
// keep_condition is an OTTL boolean built by the caller (typically Helm, from
// the tenant's namespace list) that is TRUE for records to DROP -- i.e. it
// matches every namespace EXCEPT this tenant's, so only this tenant's records
// survive. A record whose namespace is in no tenant_route survives none and is
// dropped (strict enforcement). The enriched signals enter via the exported
// logs_input / traces_input consumers.
//
// Instantiate once per tenant and wire the gateway's logs_forward_to /
// traces_forward_to to the exports:
//
//   k8s_otel.tenant_route "acme" {
//       tenant_id           = "acme"
//       keep_condition      = "resource.attributes[\"k8s.namespace.name\"] != \"acme-ns\""
//       logs_endpoint       = sys.env("LOKI_OTLP_ENDPOINT_URL")
//       traces_endpoint     = sys.env("OTLPHTTP_CLIENT_ENDPOINT")
//       basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//   }
//   k8s_otel.default "otlp" {
//       logs_forward_to   = [k8s_otel.tenant_route.acme.logs_input]
//       traces_forward_to = [k8s_otel.tenant_route.acme.traces_input]
//       ...
//   }
declare "tenant_route" {
	// -- Required -----------------------------------------------------------
	argument "tenant_id" {
		comment = "The tenant (X-Scope-OrgID) stamped on this route's exported logs and traces"
	}
	argument "keep_condition" {
		comment = "OTTL boolean, TRUE for records to drop; matches every namespace except this tenant's, so only this tenant's records survive"
	}
	argument "logs_endpoint" {
		comment = "OTLP-HTTP base endpoint for this tenant's logs (e.g. Loki's \"<addr>/otlp\")"
	}
	argument "traces_endpoint" {
		comment = "OTLP-HTTP base endpoint for this tenant's traces (e.g. Tempo)"
	}
	argument "basic_auth_username" {
		comment = "Basic-auth username for the logs and traces endpoints"
	}
	argument "basic_auth_password" {
		comment = "Basic-auth password for the logs and traces endpoints"
	}

	// Enriched logs/traces enter here; the gateway forwards to these.
	export "logs_input" {
		value = otelcol.processor.filter.logs.input
	}
	export "traces_input" {
		value = otelcol.processor.filter.traces.input
	}

	otelcol.auth.basic "default" {
		username = argument.basic_auth_username.value
		password = argument.basic_auth_password.value
	}

	otelcol.processor.filter "logs" {
		error_mode = "ignore"
		logs {
			log_record = [
				argument.keep_condition.value,
			]
		}
		output {
			logs = [otelcol.exporter.otlphttp.logs.input]
		}
	}

	otelcol.exporter.otlphttp "logs" {
		client {
			endpoint = argument.logs_endpoint.value
			auth     = otelcol.auth.basic.default.handler
			headers  = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}
	}

	otelcol.processor.filter "traces" {
		error_mode = "ignore"
		traces {
			span = [
				argument.keep_condition.value,
			]
		}
		output {
			traces = [otelcol.exporter.otlphttp.traces.input]
		}
	}

	otelcol.exporter.otlphttp "traces" {
		client {
			endpoint = argument.traces_endpoint.value
			auth     = otelcol.auth.basic.default.handler
			headers  = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}
	}
}
