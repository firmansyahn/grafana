// self_monitor -- Alloy meta-monitoring.
//
// Ships Alloy's own internal telemetry to the observability stack so a silent
// pipeline failure is visible.
//
// Three signals:
//   - Metrics: collected via prometheus.exporter.self, scraped by a dedicated
//     NON-clustered prometheus.scrape, and remote_written to Mimir with an
//     X-Scope-OrgID header. The scrape opts out of clustering on purpose:
//     prometheus.exporter.self sets instance=<hostname>, which differs per
//     node -- consistent-hash target distribution would assign all of them to
//     one node. A dedicated non-clustered scrape means every DaemonSet pod
//     scrapes its OWN self-metrics (per-node collector health, what we want).
//
//   - Logs:   fanned in from the top-level `logging.write_to`, enriched with
//     cluster/region/zone static labels, annotated with the Alloy pod name as
//     structured metadata (queryable but not indexed), and pushed to Loki under
//     the same tenant.
//
//   - Traces: fanned in from the top-level `tracing.write_to` and exported
//     to Tempo (OTLP gRPC) under the same tenant header.
//
// Top-level `logging` and `tracing` blocks are singletons and cannot live
// inside a declare, so this module exposes log/traces receivers as exports
// for the importer to wire into its `write_to` arguments. Metrics are fully
// self-contained.
//
// Delivery -- per signal, embedded sink or <signal>_forward_to, mutually
// exclusive, as in host_metrics:
//   - Default: the embedded prometheus.remote_write, loki.write and
//     otelcol.exporter.otlp, configured with tenant_id, the *_endpoint
//     arguments and basic_auth_*.
//   - metrics_forward_to / logs_forward_to / traces_forward_to: send that
//     signal to receivers of your own instead -- e.g. a prometheus.remote_write,
//     loki.write or otelcol exporter defined outside the module -- and its
//     embedded sink is never fed. The signal's *_endpoint can then be left
//     out, and tenant_id and basic_auth_* too once no embedded sink is used.
//     The tenant comes from YOUR sink then: tenant_id is applied only by the
//     embedded ones. Same for metrics' external labels (cluster_name, region,
//     zone), which belong to the remote_write; on logs they are static labels
//     set in the pipeline and survive logs_forward_to.
//
// Usage (the write_to references must include the instance label -- "alloy"
// below -- since exports live on the instance, e.g.
// self_monitor.default.alloy.logs_receiver):
//   logging { write_to = [self_monitor.default.alloy.logs_receiver] }
//   tracing { write_to = [self_monitor.default.alloy.traces_input] }
//
//   self_monitor.default "alloy" {
//       tenant_id           = "my-tenant"
//       metrics_endpoint    = sys.env("MIMIR_ENDPOINT_URL")
//       logs_endpoint       = sys.env("LOKI_ENDPOINT_URL")
//       traces_endpoint     = sys.env("OTLP_CLIENT_ENDPOINT")
//       basic_auth_username = sys.env("AUTH_BASIC_USERNAME")
//       basic_auth_password = sys.env("AUTH_BASIC_PASSWORD")
//       cluster_name        = sys.env("CLUSTER_NAME")
//       region              = sys.env("REGION")
//       zone                = sys.env("ZONE")
//   }
//
// Usage (every signal forwarded to sinks defined outside the module):
//   self_monitor.default "alloy" {
//       metrics_forward_to = [prometheus.remote_write.mimir.receiver]
//       logs_forward_to    = [loki.write.loki.receiver]
//       traces_forward_to  = [otelcol.exporter.otlp.tempo.input]
//       cluster_name       = sys.env("CLUSTER_NAME")
//   }
declare "default" {
	// -- Delivery: embedded sinks, or <signal>_forward_to ---------------------
	// An explicit [] coalesces to the default -- pass a real receiver, or omit.
	argument "metrics_forward_to" {
		comment  = "list(MetricsReceiver) to send self-metrics to INSTEAD of the embedded remote_write, e.g. a prometheus.remote_write defined outside the module (default: unset, use the embedded remote_write)"
		optional = true
	}

	argument "logs_forward_to" {
		comment  = "list(LogsReceiver) to send self-logs to INSTEAD of the embedded loki.write, after this module's level filter and labels (default: unset, use the embedded loki.write)"
		optional = true
	}

	argument "traces_forward_to" {
		comment  = "list(otelcol.Consumer) to send batched self-traces to INSTEAD of the embedded OTLP exporter (default: unset, use the embedded exporter)"
		optional = true
	}

	// Tenant (X-Scope-OrgID) for all three embedded sinks. Mimir via
	// remote_write headers, Loki via loki.write.endpoint.tenant_id, Tempo via
	// the otelcol.exporter.otlp client headers.
	argument "tenant_id" {
		comment  = "The tenant (X-Scope-OrgID) for the embedded metrics, logs and traces sinks. Required unless every signal is forwarded."
		optional = true
		default  = ""
	}
	// The endpoint defaults point at a local Mimir, Loki and Tempo, so a
	// signal left with neither an endpoint nor a forward_to fails loudly with
	// connection errors rather than silently discarding its telemetry.
	argument "metrics_endpoint" {
		comment  = "Mimir push URL for self-metrics (e.g. https://mimir.../api/v1/push). Required unless metrics_forward_to is set."
		optional = true
		default  = "http://localhost:9009/api/v1/push"
	}

	argument "logs_endpoint" {
		comment  = "Loki push URL for self-logs (e.g. https://loki.../loki/api/v1/push). Required unless logs_forward_to is set."
		optional = true
		default  = "http://localhost:3100/loki/api/v1/push"
	}

	argument "traces_endpoint" {
		comment  = "OTLP gRPC endpoint for self-traces (e.g. tempo...:4317). Required unless traces_forward_to is set."
		optional = true
		default  = "localhost:4317"
	}
	// Alloy has no conditional blocks, so basic_auth is always present on the
	// embedded sinks. Left empty, metrics and logs send an empty Basic header
	// and traces anonymous:anonymous (see otelcol.auth.basic below), which an
	// endpoint without authentication ignores.
	argument "basic_auth_username" {
		comment  = "Basic-auth username for the embedded sinks (default: \"\", no credentials)"
		optional = true
		default  = ""
	}

	argument "basic_auth_password" {
		comment  = "Basic-auth password for the embedded sinks (default: \"\", no credentials)"
		optional = true
		default  = ""
	}

	// -- Optional -----------------------------------------------------------
	argument "cluster_name" {
		comment  = "Value for the cluster_name external label on metrics, and a static label on logs (default: \"\", unset)"
		optional = true
	}

	argument "region" {
		comment  = "Value for the region external label on metrics, and a static label on logs (default: \"\", unset)"
		optional = true
	}

	argument "zone" {
		comment  = "Value for the zone external label on metrics, and a static label on logs (default: \"\", unset)"
		optional = true
	}
	// Uses `default` rather than relying on coalesce alone at the use site for
	// the same reason as elsewhere in these modules -- but the use site ALSO
	// coalesces, because an unset argument and an unknown key fail differently
	// and both have to land on "ship everything". See the stage.drop comment.
	argument "logs_min_level" {
		comment  = "Lowest self-log level shipped to Loki: \"debug\" (default, ship everything), \"info\", \"warn\" or \"error\". The top-level logging block's `level` gates stderr AND write_to together, so pair logging.level = \"info\" with logs_min_level = \"warn\" to keep info in kubectl logs while shipping only warn+. This only ever NARROWS: a level the logging block never emits cannot appear here."
		optional = true
		default  = "debug"
	}

	// ----- Metrics: fully self-contained -------------------------------------
	// Self-internal metrics (loki_process_dropped_lines_total, remote_write
	// queue/failure counters, otelcol receiver refusals, WAL state, etc.).
	prometheus.exporter.self "alloy" { }

	prometheus.scrape "alloy" {
		targets    = prometheus.exporter.self.alloy.targets
		forward_to = coalesce(argument.metrics_forward_to.value, [prometheus.remote_write.alloy.receiver])

		clustering {
			enabled = false
		}
	}

	prometheus.remote_write "alloy" {
		endpoint {
			url = argument.metrics_endpoint.value

			basic_auth {
				username = argument.basic_auth_username.value
				password = argument.basic_auth_password.value
			}

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}
		}

		external_labels = {
			cluster_name = coalesce(argument.cluster_name.value, ""),
			region       = coalesce(argument.region.value, ""),
			zone         = coalesce(argument.zone.value, ""),
		}
	}

	// ----- Logs: entered from top-level `logging.write_to` ------------------
	// the top-level `logging` block tees Alloy's own log entries here. Keep
	// stable dimensions as indexed labels, but demote pod to structured metadata:
	// DaemonSet pod names contain rollout/restart suffixes, so indexing them
	// would churn Loki streams while providing little selector value.
	loki.process "alloy" {
		forward_to = coalesce(argument.logs_forward_to.value, [loki.write.alloy.receiver])

		// Level filter. The top-level `logging` block's own `level` gates
		// stderr AND write_to together, so it cannot express "info visible in
		// kubectl logs, warn+ shipped to Loki" -- that split has to happen
		// here. write_to attaches no level label; the level exists only as a
		// field inside the line, so parse it back out. Requires the caller to
		// set logging.format = "logfmt" (the default in our configs).
		stage.logfmt {
			mapping = {"level" = "level"}
		}

		// The map turns "lowest level to keep" into "levels below it".
		//
		// The coalesce is load-bearing, not defensive noise. An unknown key --
		// a typo like "warning", or a caller on an older chart passing
		// something else -- yields an EMPTY expression, and an empty RE2
		// matches EVERY line, silently dropping all self-logs in the one
		// pipeline whose job is reporting that the collector is broken. Alloy
		// does not reject the bad key: `alloy validate` exits 0 on it, and a
		// runtime A/B confirmed the failure is total and silent (bad key
		// forwarded 0 of 23 entries; with this coalesce it forwarded all of
		// them). Falling back to a never-matching pattern makes a typo fail
		// OPEN -- noisy rather than blind.
		//
		// Same reasoning covers unparseable input: a non-logfmt line, or one
		// with no level field, extracts "" which matches none of these
		// patterns and is kept.
		stage.drop {
			source     = "level"
			expression = coalesce({
				"debug" = "^\\x00$",
				"info"  = "^(debug)$",
				"warn"  = "^(debug|info)$",
				"error" = "^(debug|info|warn)$",
			}[coalesce(argument.logs_min_level.value, "debug")], "^\\x00$")
			drop_counter_reason = "self_log_below_min_level"
		}

		stage.static_labels {
			values = {
				cluster_name = coalesce(argument.cluster_name.value, ""),
				region       = coalesce(argument.region.value, ""),
				pod          = sys.env("HOSTNAME"),
				zone         = coalesce(argument.zone.value, ""),
			}
		}

		stage.structured_metadata {
			values = {
				pod = "",
			}
		}
	}

	loki.write "alloy" {
		endpoint {
			url = argument.logs_endpoint.value

			basic_auth {
				username = argument.basic_auth_username.value
				password = argument.basic_auth_password.value
			}

			tenant_id = argument.tenant_id.value
		}
	}

	export "logs_receiver" {
		value = loki.process.alloy.receiver
	}

	// ----- Traces: entered from top-level `tracing.write_to` -----------------
	// The top-level `tracing` block tees Alloy's own spans here. We export as
	// OTLP gRPC under the same tenant header. Basic auth shared with the
	// metrics/logs sinks via a single auth.basic handler; the X-Scope-OrgID
	// header is added per-export since it identifies the tenant.
	otelcol.processor.batch "alloy" {
		output {
			traces = coalesce(argument.traces_forward_to.value, [otelcol.exporter.otlp.alloy.input])
		}
	}

	otelcol.exporter.otlp "alloy" {
		client {
			endpoint = argument.traces_endpoint.value

			headers = {
				"X-Scope-OrgID" = argument.tenant_id.value,
			}

			auth = otelcol.auth.basic.default.handler
		}
	}

	// otelcol.auth.basic refuses an empty username or password ("no password
	// provided"), which would fail the whole instance even when traces go to
	// traces_forward_to and this exporter is never fed. With no credentials
	// passed, the embedded exporter therefore sends anonymous:anonymous, which
	// an endpoint without authentication ignores and one with it rejects.
	otelcol.auth.basic "default" {
		username = coalesce(argument.basic_auth_username.value, "anonymous")
		password = coalesce(argument.basic_auth_password.value, "anonymous")
	}

	export "traces_input" {
		value = otelcol.processor.batch.alloy.input
	}
}
