{
  "uid": "host-logs",
  "title": "Host Logs",
  "description": "Logs collected by the startechnica/grafana host_logs module (alloy/modules/host_logs.alloy): the systemd journal, classic /var/log files, and received network syslog. Templated on job/node/app/level so one dashboard serves every host and all three declares. This is the LOG CONTENT view -- for collector health (lines dropped by reason, Loki write failures, queue depth) see 'Alloy / Collector Health'. Note the module drops container stdout/stderr and Podman healthcheck bookkeeping by default, so what you see here is the host's own story: logins, sudo, sshd, systemd, kernel, and audit records for real service transitions.",
  "tags": [
    "alloy",
    "logs",
    "hosts",
    "host_logs"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "loki",
          "value": "loki"
        },
        "hide": 0
      },
      {
        "name": "job",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "job",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "definition": "label_values(job)",
        "multi": true,
        "includeAll": true,
        "_comment_allValue": "Must be .+, not .*: Loki rejects a stream selector in which every matcher is empty-compatible. job is the one label host_logs sets unconditionally, so it carries the non-empty matcher for the whole dashboard; node/app/level stay .* so an entry missing one of them is not silently hidden.",
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "node",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "node",
          "stream": "{job=~\"${job:regex}\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "definition": "label_values({job=~\"$job\"}, node)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "app",
          "stream": "{job=~\"${job:regex}\", node=~\"${node:regex}\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "definition": "label_values({job=~\"$job\", node=~\"$node\"}, app)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "level",
          "stream": "{job=~\"${job:regex}\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "definition": "label_values({job=~\"$job\"}, level)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "search",
        "label": "Line contains (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Lines",
      "description": "Total log lines matching the current filters over the dashboard time range. This is what actually reached Loki -- the module drops container logs and Podman healthcheck noise before this point, so a lower number than you expect is usually that, not loss. Zero across all hosts means the pipeline is down: check 'Alloy / Collector Health'.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"${level:regex}\"} |~ \"$search\" [$__auto]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors",
      "description": "Lines at level error, critical or fatal in the current range. The module normalizes journald priorities and syslog severities onto one vocabulary, so this counts emerg/alert/crit/err from every source. NOTE: with container logs excluded by default, a Podman host's journal has almost no error-level entries -- application errors live wherever container logs are collected, not here.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"error|critical|fatal\"} |~ \"$search\" [$__auto]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warnings",
      "description": "Lines at level warn in the current range (syslog 'warning' and journald 'warning' both fold to this). Useful as the early-warning companion to Errors: disk pressure, failed units retrying, and auth anomalies often appear here first.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=\"warn\"} |~ \"$search\" [$__auto]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hosts reporting",
      "description": "Distinct hosts that sent at least one line in the range, for the selected sources. Compare against the number of hosts you EXPECT: this dashboard cannot show a host that never reported, so a count below your fleet size is the signal that a collector is down, its journal is unreadable, or its credentials are wrong. The per-host volume panel below shows which one went quiet.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (node) (count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\"} [$__auto])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Volume and coverage",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lines by level",
      "description": "Log volume over time, split by the module's normalized level. Stacked bars so total volume and its composition read at once. Colors are reserved status colors -- red for error and above, orange for warn, blue for info, grey for unknown -- and never reused for anything else on this dashboard. Kernel audit records carry no priority, so the module derives their level from the record's own fields: a successful audited operation is info, a failed one or an SELinux denial is warn. What is left at 'unknown' is genuinely unlabelled -- on the hosts here that is BPF load/unload records, which carry no outcome at all.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (level) (count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"${level:regex}\"} |~ \"$search\" [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fatal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lines by host",
      "description": "Volume per host over time. This is the coverage panel: a line that flatlines to zero while the others continue is a collector that stopped, a journal that became unreadable, or a host that went down -- and it is visible here long before anyone notices missing logs. A line that suddenly spikes is usually a boot, a rollout, or a log loop.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"${level:regex}\"} |~ \"$search\" [$__auto]))",
          "legendFormat": "{{node}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "What is making the noise",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top apps",
      "description": "The ten busiest programs in the range -- SYSLOG_IDENTIFIER from the journal, APP-NAME from received syslog, or the tag parsed out of a /var/log line. A single hue encodes magnitude only; these bars rank volume, they do not signal health. Use it to find what to filter out next, or to spot a program that suddenly started shouting.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (app) (count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"${level:regex}\"} |~ \"$search\" [$__auto])))",
          "legendFormat": "{{app}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-blues"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Top systemd units",
      "description": "The ten busiest systemd units (journal only). The module collapses per-event unit names before they are indexed -- session-1234.scope becomes session.scope, docker-<hash>.scope becomes docker.scope, and Podman's per-healthcheck transient units become transient.service -- so these are stable names rather than one entry per login or container start. Without that collapsing a single host here produced over 200 unit values, 82% of them churn.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (unit) (count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"${level:regex}\"} |~ \"$search\" [$__auto])))",
          "legendFormat": "{{unit}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-blues"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "By transport",
      "description": "How entries reached journald: 'journal' (written via the journal API, including most container runtimes), 'syslog' (through /dev/log -- sshd and sudo on most distributions), 'stdout', 'kernel' (the ring buffer) and 'audit' (kernel audit records). A sudden loss of one transport is a narrower and more diagnostic signal than total volume dropping -- for example losing 'audit' alone means auditd stopped, not the collector.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\", app=~\"${app:regex}\", level=~\"${level:regex}\"} |~ \"$search\" [$__auto]))",
          "legendFormat": "{{transport}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-blues"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Access and privilege",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Failed auth events",
      "description": "Lines matching common authentication-failure phrasings across sshd, sudo, PAM and the kernel audit subsystem. Zero is the normal reading and is meaningful -- this panel being empty means no failures, not a broken query. A sustained non-zero rate on an internet-reachable host is a brute-force attempt; a burst on an internal host is usually a stale credential or an expired key.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({job=~\"${job:regex}\", node=~\"${node:regex}\"} |~ \"(?i)(authentication failure|failed password|invalid user|res=failed|failed publickey|not in the sudoers)\" [$__auto]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
